# Loaded automatically from this directory, regardless of the launch directory.
# Copy to .env (gitignored), populate, then restart the backend.
# Existing shell environment variables take precedence.

# Required: Foundry project API endpoint from the project's Overview page.
# Example: https://my-account.services.ai.azure.com/api/projects/my-project
FOUNDRY_PROJECT_ENDPOINT=

# Optional: initialize the bundled routine with this existing prompt agent.
# Otherwise select the real agent in the UI.
FOUNDRY_AGENT_NAME=

# Authentication uses the default Azure developer credential chain.
# Use your existing authenticated dev tools. No API key, token or client secret.
# If your tools use a nondefault config directory, uncomment and set it here:
# AZURE_CONFIG_DIR=

# Public, local-only fixture credentials. Never use these for external databases.
FOUNDRY_DEMO_POSTGRES_PASSWORD=local-fixture-only
FOUNDRY_DEMO_MYSQL_PASSWORD=local-fixture-only
