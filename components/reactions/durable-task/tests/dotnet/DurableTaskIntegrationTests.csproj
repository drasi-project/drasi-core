<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ExampleRoot>../../../../../examples/lib/durable-task</ExampleRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="$(ExampleRoot)/dotnet/OrderWorkflow.cs" Link="Example/OrderWorkflow.cs" />
    <Compile Include="$(ExampleRoot)/dotnet/Program.cs" Link="Example/Walkthrough.cs" />
    <Compile Include="$(ExampleRoot)/dotnet/infrastructure/DemoConsole.cs" Link="Example/DemoConsole.cs" />
    <Compile Include="$(ExampleRoot)/dotnet/infrastructure/DemoHost.cs" Link="Example/DemoHost.cs" />
    <Compile Include="$(ExampleRoot)/dotnet/infrastructure/OrdersDatabase.cs" Link="Example/OrdersDatabase.cs" />
    <Content Include="reaction.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../native/schema.sql" Link="recovery-schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="packages.lock.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.DurableTask.AzureManagedBackend" Version="1.10.4" />
    <PackageReference Include="Microsoft.DurableTask.Worker.AzureManaged" Version="1.27.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
