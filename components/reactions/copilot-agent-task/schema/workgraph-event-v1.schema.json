{
  "$defs": {
    "failedResult": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "additionalProperties": false,
          "properties": {
            "found": {
              "const": false
            },
            "requiredMarker": {
              "const": "WorkGraph-Validation: pass"
            }
          },
          "required": [
            "requiredMarker",
            "found"
          ],
          "type": "object"
        },
        "outcome": {
          "const": "failed"
        },
        "reasonCode": {
          "const": "required-marker-missing"
        },
        "summary": {
          "const": "The required prototype marker is missing."
        }
      },
      "required": [
        "outcome",
        "reasonCode",
        "evidence",
        "summary"
      ],
      "type": "object"
    },
    "passedResult": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "additionalProperties": false,
          "properties": {
            "found": {
              "const": true
            },
            "requiredMarker": {
              "const": "WorkGraph-Validation: pass"
            }
          },
          "required": [
            "requiredMarker",
            "found"
          ],
          "type": "object"
        },
        "outcome": {
          "const": "passed"
        },
        "reasonCode": {
          "const": "required-marker-present"
        },
        "summary": {
          "const": "The required prototype marker is present."
        }
      },
      "required": [
        "outcome",
        "reasonCode",
        "evidence",
        "summary"
      ],
      "type": "object"
    }
  },
  "$id": "https://drasi-project.github.io/workgraph/schemas/workgraph-event-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actorId": {
      "minLength": 1,
      "type": "string"
    },
    "actorType": {
      "enum": [
        "Agent",
        "Human"
      ]
    },
    "completedAt": {
      "format": "date-time",
      "type": "string"
    },
    "contentVersion": {
      "format": "date-time",
      "type": "string"
    },
    "eventId": {
      "minLength": 1,
      "type": "string"
    },
    "eventType": {
      "const": "CompletedIssueValidation"
    },
    "executionId": {
      "minLength": 1,
      "type": "string"
    },
    "profileRef": {
      "pattern": "^issue-validator@.+$",
      "type": "string"
    },
    "projectItemNodeId": {
      "minLength": 1,
      "type": "string"
    },
    "repository": {
      "pattern": "^[^/]+/[^/]+$",
      "type": "string"
    },
    "responsibilityId": {
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/passedResult"
        },
        {
          "$ref": "#/$defs/failedResult"
        }
      ]
    },
    "routeId": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "workgraph.event/v1"
    },
    "subjectNodeId": {
      "minLength": 1,
      "type": "string"
    },
    "subjectNumber": {
      "minimum": 1,
      "type": "integer"
    },
    "subjectType": {
      "const": "Issue"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "projectItemNodeId",
    "subjectType",
    "subjectNodeId",
    "repository",
    "subjectNumber",
    "actorType",
    "actorId",
    "routeId",
    "responsibilityId",
    "executionId",
    "contentVersion",
    "profileRef",
    "result",
    "completedAt"
  ],
  "title": "WorkGraphEvent/v1",
  "type": "object"
}
