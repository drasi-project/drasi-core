+                "reservation '{}' ownership changed before {} (owner='{}' epoch={})",
+                owned.record.reservation_key,
+                action,
+                owned
+                    .record
+                    .owner_instance_id
+                    .as_deref()
+                    .unwrap_or("unknown"),
+                owned.record.fencing_epoch
