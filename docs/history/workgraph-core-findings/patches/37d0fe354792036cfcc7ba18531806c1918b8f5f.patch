+async fn renew_reservation_ownership(
+    store: Arc<dyn StateStoreProvider>,
+    store_id: &str,
+    config: &WorkgraphRouterReactionConfig,
+    runner_instance_id: &str,
+    owned: &mut OwnedReservation,
