+/// Regression test for checkpoint ownership crossing the dynamic reaction FFI
+/// boundary and reaching manager live-enqueue persistence semantics.
+///
+/// The workgraph-router reaction reports `checkpoint_ownership() = Reaction`.
+/// We feed it query results that fail candidate deserialization, so the
+/// reaction itself never advances checkpoints. If ownership forwarding breaks
+/// and defaults to manager-owned, the runtime would still persist a live
+/// checkpoint > 0 at enqueue time. We assert that this never happens through
+/// the plugin proxy path.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+#[ignore = "requires cdylib: make build-test-plugins (drasi-source-mock + drasi-reaction-workgraph-router)"]
+async fn test_ffi_reaction_checkpoint_ownership_reaches_manager_live_enqueue() {
+    use drasi_lib::reactions::ManagerCheckpointOwnership;
+    use drasi_lib::state_store::StateStoreProvider;
+
+    if !plugin_exists("drasi-source-mock") || !plugin_exists("drasi-reaction-workgraph-router") {
+        panic!("SKIP: required cdylib plugins not built (drasi-source-mock, drasi-reaction-workgraph-router)");
+    }
+
+    let mock_source_path = require_plugin("drasi-source-mock");
+    let router_reaction_path = require_plugin("drasi-reaction-workgraph-router");
+
+    let source_plugin = load_plugin_from_path(
+        &mock_source_path,
+        std::ptr::null_mut(),
+        callbacks::default_log_callback_fn(),
+        std::ptr::null_mut(),
+        callbacks::default_lifecycle_callback_fn(),
+    )
+    .expect("Should load mock source plugin");
+
+    let reaction_plugin = load_plugin_from_path(
+        &router_reaction_path,
+        std::ptr::null_mut(),
+        callbacks::default_log_callback_fn(),
+        std::ptr::null_mut(),
+        callbacks::default_lifecycle_callback_fn(),
+    )
+    .expect("Should load workgraph-router reaction plugin");
+
+    let source = source_plugin.source_plugins[0]
+        .create_source(
+            "router-ffi-source",
+            &serde_json::json!({
+                "dataType": { "type": "counter" },
+                "intervalMs": 50
+            }),
+            true,
+        )
+        .await
+        .expect("Should create mock source");
+
+    let query_id = "route-awaiting-workgraph-items";
+    let reaction_id = "router-ffi-reaction";
+    let reaction = reaction_plugin.reaction_plugins[0]
+        .create_reaction(
+            reaction_id,
+            vec![query_id.to_string()],
+            &serde_json::json!({
+                "policyId": "checkpoint-ownership-regression",
+                "policyType": "rules_v1",
+                "policyVersion": "1.0.0",
+                "allowedProjects": ["PVT_test"],
+                "allowedRepos": ["drasi-project/drasi-core"],
+                "allowedEventTypes": ["CompletedIssueValidation"],
+                "allowedStatusTransitions": [{ "from": "AwaitingRouting", "to": "AwaitingIssueRiskProfiling" }],
+                "allowedResponsibilityTypes": ["issue-validation"],
+                "allowedActors": [],
+                "trustedRoutingAuthors": [],
+                "trustedLauncherAuthors": [],
+                "trustedAgentAuthors": [],
+                "trustedRouterAuthors": [],
+                "trustedRouterAuthorNodeIds": ["MDQ6VXNlcjE="],
+                "trustedRouterAuthorDatabaseIds": [],
+                "githubGraphqlUrl": "https://api.github.com/graphql",
+                "githubRestUrl": "https://api.github.com",
+                "githubTokenEnv": "PATH",
+                "projectStatusFieldName": "Status",
+                "timeoutSecs": 10,
+                "reservationLeaseSecs": 30,
+                "strictRecovery": true
+            }),
+            true,
+        )
+        .await
+        .expect("Should create workgraph-router reaction");
+
+    assert_eq!(
+        reaction.checkpoint_ownership(),
+        ManagerCheckpointOwnership::Reaction,
+        "checkpoint ownership must cross FFI proxy as Reaction-owned"
+    );
+
+    let store = std::sync::Arc::new(DurableMemoryStateStore::new());
+    let core = drasi_lib::DrasiLib::builder()
+        .with_id("router-ffi-checkpoint-core")
+        .with_state_store_provider(store.clone())
+        .with_source(source)
+        .with_query(
+            drasi_lib::Query::cypher(query_id)
+                .query("MATCH (n:Counter) RETURN n.value AS value")
+                .from_source("router-ffi-source")
+                .build(),
+        )
+        .with_reaction(reaction)
+        .build()
+        .await
+        .expect("Should build DrasiLib");
+
+    core.start().await.expect("Should start DrasiLib");
+    tokio::time::sleep(std::time::Duration::from_millis(1500)).await;
+
+    let query_results = core
+        .get_query_results(query_id)
+        .await
+        .expect("Should read query results");
+    assert!(
+        !query_results.is_empty(),
+        "query should produce live results so enqueue path is exercised"
+    );
+
+    core.stop().await.expect("Should stop DrasiLib");
+
+    let checkpoint_key = format!("checkpoint:{query_id}");
+    let checkpoint_bytes = store
+        .get(reaction_id, &checkpoint_key)
+        .await
+        .expect("state store get should succeed");
+
+    let bytes = checkpoint_bytes.expect(
+        "startup should seed a checkpoint entry; missing checkpoint means test did not exercise persistence path",
+    );
+    let checkpoint: drasi_lib::reactions::ReactionCheckpoint =
+        bincode::deserialize(&bytes).expect("checkpoint bytes should deserialize");
+    assert_eq!(
+        checkpoint.sequence, 0,
+        "reaction-owned checkpoint semantics should prevent manager enqueue-time persistence beyond sequence 0"
+    );
+}
