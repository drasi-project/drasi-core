+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct RoutingCandidate {
+    pub execution_id: String,
+    pub required_event_type: String,
+    pub event_id: String,
+    pub event_type: String,
+    pub outcome: String,
+    pub subject_repo: String,
+    pub subject_issue_number: u64,
+    pub project_id: String,
+    pub project_item_id: String,
+    pub project_status: String,
+    pub route_id: String,
+    pub route_expected_event_id: String,
+    pub route_expected_event_type: String,
+    pub route_expected_subject_repo: String,
+    pub route_expected_subject_issue_number: u64,
+    pub route_content_version: String,
+    pub route_content_profile: String,
+    pub responsibility_id: String,
+    pub responsibility_type: String,
+    pub responsibility_actor: String,
+    pub submitter_actor: String,
+    pub launcher_author: String,
+    pub agent_author: String,
+    pub router_author: String,
+    pub routing_author: String,
+    #[serde(default)]
+    pub observed_authors: Vec<String>,
+    pub comment_id: u64,
+    pub comment_author: String,
+    pub comment_body: String,
+    pub comment_edited: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment_created_at: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub comment_updated_at: Option<String>,
+    pub comment_provenance_event_id: String,
+    pub comment_provenance_event_type: String,
+    pub content_version: String,
+    pub content_profile: String,
+}
+
+impl RoutingCandidate {
+    pub fn reservation_key(&self) -> String {
+        format!("{}:{}", self.execution_id, self.required_event_type)
+    }
+
+    pub fn candidate_fingerprint(&self) -> String {
+        let mut observed_authors = self.observed_authors.clone();
+        observed_authors.sort();
+        observed_authors.dedup();
+
+        let canonical = serde_json::json!({
+            "event": {
+                "id": self.event_id,
+                "type": self.event_type,
+                "executionId": self.execution_id,
+                "requiredEventType": self.required_event_type,
+            },
+            "subject": {
+                "repo": self.subject_repo,
+                "issueNumber": self.subject_issue_number,
+            },
+            "project": {
+                "id": self.project_id,
+                "itemId": self.project_item_id,
+            },
+            "route": {
+                "id": self.route_id,
+                "expectedEventId": self.route_expected_event_id,
+                "expectedEventType": self.route_expected_event_type,
+                "expectedSubjectRepo": self.route_expected_subject_repo,
+                "expectedSubjectIssueNumber": self.route_expected_subject_issue_number,
+                "contentVersion": self.route_content_version,
+                "contentProfile": self.route_content_profile,
+            },
+            "responsibility": {
+                "id": self.responsibility_id,
+                "type": self.responsibility_type,
+                "actor": self.responsibility_actor,
+            },
+            "provenance": {
+                "commentId": self.comment_id,
+                "commentAuthor": self.comment_author,
+                "commentProvenanceEventId": self.comment_provenance_event_id,
+                "commentProvenanceEventType": self.comment_provenance_event_type,
+                "routingAuthor": self.routing_author,
+                "launcherAuthor": self.launcher_author,
+                "agentAuthor": self.agent_author,
+                "routerAuthor": self.router_author,
+                "observedAuthors": observed_authors,
+            },
+            "submitter": self.submitter_actor,
+            "content": {
+                "version": self.content_version,
+                "profile": self.content_profile,
+            }
+        });
+
+        let canonical_json = serde_json::to_string(&canonical)
+            .expect("candidate fingerprint payload must serialize");
+        Uuid::new_v5(&Uuid::NAMESPACE_OID, canonical_json.as_bytes()).to_string()
+    }
+
+    pub fn outcome_key(&self) -> &str {
+        self.outcome.trim()
+    }
+}
