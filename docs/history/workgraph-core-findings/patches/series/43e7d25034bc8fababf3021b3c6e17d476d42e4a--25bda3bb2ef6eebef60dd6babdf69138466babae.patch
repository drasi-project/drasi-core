+
+        owner_a.record.lease_expires_at_unix_secs = chrono::Utc::now().timestamp() - 1;
+        crate::state::save_reservation(store.clone(), "router-state-store", &owner_a.record)
+            .await
+            .expect("expire owner a lease");
+        owner_a.persisted_bytes =
