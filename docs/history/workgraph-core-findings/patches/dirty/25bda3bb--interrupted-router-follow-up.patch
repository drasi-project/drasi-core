+fn ensure_legacy_fingerprint_bind_is_pristine(
+    reservation: &ReservationRecord,
+    state: &RoutingStateRecord,
+    strict_recovery: bool,
+) -> anyhow::Result<()> {
+    let reservation_has_usage_markers = reservation.decision_id.is_some() || reservation.completed;
+    let state_has_usage_markers = routing_state_has_recorded_work(state);
+    if !reservation_has_usage_markers && !state_has_usage_markers {
+        return Ok(());
+    }
+
+    let resolution_hint = if strict_recovery {
+        "strictRecovery=true: startup is blocked until manual migration/resolution completes"
+    } else {
+        "manual migration/resolution is required before this reservation can be resumed safely"
+    };
+    Err(LegacyReservationMigrationError {
+        message: format!(
+            "reservation '{}' has empty legacy candidateFingerprint but persisted state is not pristine \
+             (reservationDecisionId={}, reservationCompleted={}, hasDecision={}, hasTransition={}, \
+             hasProgress={}, failed={}, ambiguous={}, hasFailureEpoch={}, hasLastError={}); {}",
+            reservation.reservation_key,
+            reservation.decision_id.is_some(),
+            reservation.completed,
+            state.decision.is_some(),
+            state.selected_transition.is_some(),
+            state.progress != SideEffectProgress::default(),
+            state.failed,
+            state.ambiguous,
+            state.failure_fencing_epoch.is_some(),
+            state.last_error.is_some(),
+            resolution_hint
+        ),
+    }
+    .into())
