+fn routing_state_has_recorded_work(state: &RoutingStateRecord) -> bool {
+    state.decision.is_some()
+        || state.selected_transition.is_some()
+        || state.progress.decision_comment_written
+        || state.progress.responsibility_written
+        || state.progress.project_status_updated
+        || state.ambiguous
+        || state.failed
+        || state.failure_fencing_epoch.is_some()
+        || state.last_error.is_some()
+}
