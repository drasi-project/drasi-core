+    #[tokio::test]
+    async fn reservation_key_collision_rejects_mismatched_candidate_without_splitting_progress() {
+        let store: Arc<dyn StateStoreProvider> = Arc::new(DurableMemoryStateStore::new());
+        let config = sample_config();
+        let reaction_a = make_reaction("router-collision-a", &config);
+        let reaction_b = make_reaction("router-collision-b", &config);
+
+        let candidate_a = sample_candidate();
+        let mut candidate_b = sample_candidate();
+        candidate_b.subject_repo = "drasi-project/other-repo".to_string();
+        candidate_b.project_item_id = "PVTI_item_other".to_string();
+        candidate_b.comment_id = 9999;
+        candidate_b.event_id = "event-other".to_string();
+
+        let (_, owner_a, mut state_a, mut owned_state_a) = reserve_or_resume(
+            store.clone(),
+            "router-key-collision",
+            &config,
+            &candidate_a,
+            &reaction_a.runner_instance_id,
+        )
+        .await
+        .expect("candidate A reserve");
+        let mut owner_a = owner_a.expect("candidate A owner");
+
+        // Simulate a crash after the first side effect has been persisted.
+        state_a.mark_progress(SideEffectProgress {
+            decision_comment_written: true,
+            responsibility_written: false,
+            project_status_updated: false,
+        });
+        state_a.mark_error_with_epoch(
+            "simulated failure after first side effect",
+            true,
+            owner_a.record.fencing_epoch,
+        );
+        persist_state_with_ownership(
+            store.clone(),
+            "router-key-collision",
+            &config,
+            &reaction_a.runner_instance_id,
+            &mut owner_a,
+            &mut owned_state_a,
+            &state_a,
+            "persist candidate A partial progress",
+        )
+        .await
+        .expect("persist candidate A state");
+
+        let mismatch = reserve_or_resume(
+            store.clone(),
+            "router-key-collision",
+            &config,
+            &candidate_b,
+            &reaction_b.runner_instance_id,
+        )
+        .await
+        .expect_err("candidate B must be rejected on immutable-context mismatch");
+        assert!(
+            mismatch
+                .to_string()
+                .contains("different immutable candidate context"),
+            "unexpected mismatch error: {mismatch:#}"
+        );
+
+        // Candidate B must not alter persisted progress for candidate A.
+        let persisted_state = crate::state::load_routing_state(
+            store.clone(),
+            "router-key-collision",
+            &candidate_a.reservation_key(),
+        )
+        .await
+        .expect("load persisted state")
+        .expect("state exists");
+        assert!(persisted_state.progress.decision_comment_written);
+        assert!(!persisted_state.progress.responsibility_written);
+        assert!(!persisted_state.progress.project_status_updated);
+        assert_eq!(
+            persisted_state.candidate_fingerprint,
+            candidate_a.candidate_fingerprint()
+        );
+
+        // Candidate A can still resume and complete recovery with the same key.
+        let (resumed_reservation, resumed_owner, resumed_state, _) = reserve_or_resume(
+            store.clone(),
+            "router-key-collision",
+            &config,
+            &candidate_a,
+            &reaction_a.runner_instance_id,
+        )
+        .await
+        .expect("candidate A resume");
+        assert!(
+            resumed_owner.is_some(),
+            "candidate A should retain ownership"
+        );
+        assert_eq!(
+            resumed_reservation.candidate_fingerprint,
+            candidate_a.candidate_fingerprint()
+        );
+        assert!(resumed_state.progress.decision_comment_written);
+        assert!(!resumed_state.progress.responsibility_written);
+        assert!(!resumed_state.progress.project_status_updated);
+    }
